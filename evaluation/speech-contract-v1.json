{
  "version": 1,
  "scope": "Synthetic host contract regression; no physical audio or model accuracy claim",
  "cases": [
    {
      "id": "offline",
      "capabilities": {
        "onDeviceRecognition": true,
        "recognitionState": "unknown",
        "voices": [
          {
            "name": "safe",
            "locale": "en-US",
            "networkRequired": false,
            "installed": true
          }
        ]
      },
      "expectedVoices": 1,
      "recognitionState": "unknown"
    },
    {
